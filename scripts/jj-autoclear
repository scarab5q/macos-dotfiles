#!/usr/bin/env bash
# jj-autoclear: detect bookmarks whose PRs have been merged (incl. squash-merged)
# and abandon their commits + forget the bookmarks.
#
# Usage:
#   jj-autoclear            # do it
#   jj-autoclear --dry-run  # show what would happen
#   jj-autoclear --fetch    # `jj git fetch` first
set -euo pipefail

DRY_RUN=0
FETCH=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    -f|--fetch)   FETCH=1 ;;
    -h|--help)
      sed -n '2,9p' "$0" | sed 's/^# \?//'
      exit 0 ;;
    *) echo "unknown arg: $arg" >&2; exit 2 ;;
  esac
done

command -v jj >/dev/null || { echo "jj not found" >&2; exit 1; }
command -v gh >/dev/null || { echo "gh not found" >&2; exit 1; }

if [ "$FETCH" = "1" ]; then
  echo "→ jj git fetch"
  jj git fetch
fi

# Local bookmark names. Exclude:
#   - remote-tracking entries (`name@remote` — filtered by grep -v '@')
#   - conflicted bookmarks (`name??` — jj template `conflict` flag)
# Conflicted bookmarks are listed separately so the user can resolve them manually.
mapfile -t bookmarks < <(jj bookmark list -T 'if(!remote && !conflict, name ++ "\n")' 2>/dev/null | grep -v '@' | grep -v '^$' | sort -u)
mapfile -t conflicted < <(jj bookmark list -T 'if(!remote && conflict, name ++ "\n")' 2>/dev/null | grep -v '@' | grep -v '^$' | sort -u)

if [ "${#conflicted[@]}" -gt 0 ]; then
  echo "⚠  skipping ${#conflicted[@]} conflicted bookmark(s) — resolve divergence first:"
  for bm in "${conflicted[@]}"; do
    printf '   \033[33m??\033[0m %s\n' "$bm"
    # Show the divergent commits so the user can pick which to abandon.
    jj log -r "bookmarks(exact:\"$bm\")" --no-graph -T 'commit_id.short() ++ " " ++ description.first_line() ++ "\n"' 2>/dev/null | sed 's/^/        /'
  done
  echo "   fix with: jj abandon <commit_id-of-the-stale-copy>"
  echo
fi

if [ "${#bookmarks[@]}" -eq 0 ]; then
  echo "no clean local bookmarks to check"
  exit 0
fi

merged=()
for bm in "${bookmarks[@]}"; do
  pr=$(gh pr list --head "$bm" --state merged --json number,title --jq '.[0] | select(.) | "#\(.number) \(.title)"' 2>/dev/null || true)
  if [ -n "$pr" ]; then
    printf '  \033[32m✓\033[0m %-50s %s\n' "$bm" "$pr"
    merged+=("$bm")
  else
    printf '  · %-50s (no merged PR)\n' "$bm"
  fi
done

if [ "${#merged[@]}" -eq 0 ]; then
  echo "nothing to clear"
  exit 0
fi

echo
if [ "$DRY_RUN" = "1" ]; then
  echo "dry-run: would abandon + forget ${#merged[@]} bookmark(s)"
  exit 0
fi

for bm in "${merged[@]}"; do
  echo "→ abandon + forget $bm"
  # Abandon the bookmark commit. jj auto-rebases descendants onto the parent,
  # so any branches stacked on top get carried along cleanly.
  jj abandon -r "$bm" || echo "  (abandon failed, continuing)"
  jj bookmark forget "$bm" || echo "  (forget failed, continuing)"
done

echo "done"
