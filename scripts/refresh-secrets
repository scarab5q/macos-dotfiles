#!/usr/bin/env zsh
# refresh-secrets: pull cached env-var secrets from 1Password into ~/.secrets.
#
# ~/.zprofile sources ~/.secrets at every login — no `op` calls happen during
# shell startup. Run this script (interactively) whenever a secret changes;
# Touch ID will prompt once and the rest is cached as plain `export` lines.

set -euo pipefail

SECRETS_FILE="${HOME}/.secrets"

# --- Bail cleanly if the 1Password CLI isn't installed ---------------------
if ! command -v op >/dev/null 2>&1; then
  print -u2 "refresh-secrets: 1Password CLI ('op') not installed."
  print -u2 "  install:  brew install --cask 1password-cli"
  print -u2 "  leaving existing ${SECRETS_FILE} untouched."
  exit 0
fi

# --- Make sure we have a session (triggers Touch ID once) ------------------
if ! op account get >/dev/null 2>&1; then
  print -u2 "refresh-secrets: signing into 1Password (Touch ID may prompt)…"
  eval "$(op signin)" >/dev/null
fi

# --- Declare what to pull --------------------------------------------------
# Each entry is VAR_NAME=op://Vault/Item/field
# Find a reference with:  op item get <item> --format=json | jq '.fields'
# Or right-click an item field in the 1Password app → "Copy Secret Reference".
typeset -a SECRETS=(
  # "OPENAI_API_KEY=op://Private/OpenAI/api key"
  # "NPM_TOKEN=op://Private/npm/credential"
  # "LINEAR_API_TOKEN=op://Private/Linear/api token"
  # "TMS_API_KEY=op://Private/TMS/api key"
  # "TMS_API_TOKEN=op://Private/TMS/api token"
  # "TMS_API_KEY_LOCALDEV=op://Private/TMS local dev/api key"
)

if (( ${#SECRETS[@]} == 0 )); then
  print -u2 "refresh-secrets: SECRETS array is empty — edit this script and add op:// refs."
  exit 0
fi

# --- Write atomically so a failure doesn't leave a half-baked file ---------
tmpfile="$(mktemp "${SECRETS_FILE}.XXXXXX")"
chmod 600 "${tmpfile}"
trap 'rm -f "${tmpfile}"' EXIT

{
  print -- "# Auto-generated by ~/scripts/refresh-secrets — DO NOT EDIT."
  print -- "# Re-run 'refresh-secrets' to refresh from 1Password."
  print --
  for entry in "${SECRETS[@]}"; do
    name="${entry%%=*}"
    ref="${entry#*=}"
    if ! value="$(op read --no-newline "${ref}")"; then
      print -u2 "refresh-secrets: failed to read ${ref} (for ${name})"
      exit 1
    fi
    # %q quotes shell metacharacters so the file is safe to `source`.
    printf 'export %s=%q\n' "${name}" "${value}"
  done
} > "${tmpfile}"

mv -- "${tmpfile}" "${SECRETS_FILE}"
trap - EXIT
chmod 600 "${SECRETS_FILE}"
print -u2 "refresh-secrets: wrote ${#SECRETS[@]} secrets to ${SECRETS_FILE}"
